{
  "id": "lobster-skin",
  "name": "LobsterSkin",
  "description": "AI skin pack management tools powered by LobsterAI.",
  "contracts": {
    "tools": [
      "hiai_skin_manage"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "callbackUrl": {
        "type": "string",
        "description": "LobsterAI loopback bridge URL for skin management requests"
      },
      "secret": {
        "type": "string",
        "description": "Shared secret for callback authentication"
      },
      "requestTimeoutMs": {
        "type": "number",
        "minimum": 1000,
        "description": "Request timeout in milliseconds",
        "default": 30000
      }
    }
  }
}
